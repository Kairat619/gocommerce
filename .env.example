# GoCommerce Environment Configuration
# Copy this file to .env and update the values

# Server
PORT=8080
APP_ENV=development
APP_URL=http://localhost:8080

# Database
DATABASE_URL=postgres://gocommerce:gocommerce@localhost:5432/gocommerce?sslmode=disable

# Session (MUST be changed in production)
SESSION_KEY=your-secret-session-key-change-in-production

# Seeding (set to "false" to skip DB seeding)
SEED=true

# Cloudflare R2 (S3-compatible) for product images
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Rate Limiting (requests per minute)
RATE_LIMIT_LOGIN=10

# File Upload
MAX_UPLOAD_SIZE=10485760
